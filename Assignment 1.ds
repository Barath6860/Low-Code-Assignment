		workflow
		{
		form
		{
			auto_set_membership_type as "Auto-Set Membership Type"
			{
				type =  form
				form = member_profile

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set membership type to New Member for new enrollments on form load
										if(input.ID.isNull())
										{
											input.membership_type = "New Member";
										}
						)
					}
				}

			}
			age_limit_validation as "Age Limit Validation"
			{
				type =  form
				form = member_profile

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if preferred_start_date field is provided and valid
										if(input.preferred_start_date.isNull())
										{
											alert(preferred_start_date,"Please enter a valid preferred start date.");
											cancel submit;
										}
										// Calculate the age based on preferred_start_date
										// preferred_start_date is a date field, we need to check if the person is under 18
										// We compare the preferred_start_date with today's date minus 18 years
										// Get today's date
										todayDate = zoho.currentdate;
										// Calculate the date 18 years ago from today
										eighteenYearsAgo = todayDate.subYear(18);
										// If preferred_start_date is after eighteenYearsAgo, the person is under 18
										if(input.preferred_start_date > eighteenYearsAgo)
										{
											alert(preferred_start_date,"You must be at least 18 years old to enroll. Please enter a valid preferred start date.");
											cancel submit;
										}
						)
					}
				}

			}
			send_welcome_email as "Send Welcome Email"
			{
				type =  form
				form = member_profile

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the member profile record using the input email address
										memberRecord = member_profile[email_address == input.email_address];
										// Check if the record exists and has a valid email
										if(!memberRecord.email_address.isNull())
										{
											// Get the member's first name from the composite NAME field
											memberFirstName = memberRecord.member_name.first_name;
											// Get the membership type
											membershipType = memberRecord.membership_type;
											// Send welcome email to the new member
											sendmail
											[
												from :zoho.loginuserid
												to :memberRecord.email_address
												subject :"Welcome to Our Gym!"
												message :"Dear " + memberFirstName + ",\n\nWelcome to our gym membership program! We are excited to have you on board.\n\nYour membership type: " + membershipType + "\n\nWe look forward to helping you achieve your fitness goals.\n\nBest regards,\nGym Membership Team"
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			monthly_plan_renewal_reminder as "Monthly Plan Renewal Reminder"
			{
				type =  schedule
				form = member_profile
					status = inactive
				start = preferred_start_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch members with Monthly Plan
										monthlyPlanMembers = member_profile[membership_plan == "Monthly Plan"];
										// Iterate through each member and send notification
										for each  member in monthlyPlanMembers
										{
											// Validate email address exists
											if(member.email_address.isNull())
											{
												continue;
											}
											// Get member name components
											memberFirstName = member.member_name.first_name;
											memberLastName = member.member_name.last_name;
											// Construct personalized message
											subject = "Renewal Notification - Your Monthly Membership";
											message = "<p>Dear " + memberFirstName + " " + memberLastName + ",</p>";
											message = message.concat("<p>Your monthly membership plan is up for renewal. Please review your account and complete the renewal process at your earliest convenience.</p>");
											message = message.concat("<p>Thank you for being a valued member!</p>");
											message = message.concat("<p>Best regards,<br>Gym Membership Team</p>");
											// Send email notification
											sendmail
											[
												from :zoho.loginuserid
												to :member.email_address
												subject :subject
												message :message
												content type :HTML
											]
										}
					)
					}
				}
			}
		}




	}
