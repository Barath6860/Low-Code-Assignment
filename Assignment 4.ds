	reports
	{
		list class_schedule_Report
		{
			displayName = "All Class Schedules"
			show all rows from class_schedule    
			(
				class_name as "Class Name"
				trainer as "Trainer"
				class_date as "Class Date"
				class_time as "Class Time"
				max_capacity as "Max Capacity"
				current_enrollment as "Current Enrollment"
			)
		}
		list member_profile_Report
		{
			displayName = "All Member Profiles"
			show all rows from member_profile    
			(
				member_id as "Member Id"
				member_name  as "Member Name"
				contact_number as "Contact Number"
				email as "Email Address"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				membership_status as "Membership Status"
				plan_type as "Plan Type"
				enrollment_date as "Enrollment Date"
				membership_end_date as "Membership End Date"
				medical_certificate_url as "Medical Certificate URL"
				id_card_url as "ID Card URL"
				is_renewal_reminder_sent as "Is Renewal Reminder Sent"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (membership_status == "Active")
				fields = [membership_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (membership_status == "Enquiry")
				fields = [membership_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (membership_status == "Enrolled")
				fields = [membership_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (membership_status == "Expired")
				fields = [membership_status]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban member_profile_by_membership_status
		{
			displayName = "Membership Statuses"
			show all rows from member_profile    
			(
				member_id as "Member Id"
				member_name  as "Member Name"
				contact_number as "Contact Number"
				email as "Email Address"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				membership_status as "Membership Status"
				plan_type as "Plan Type"
				enrollment_date as "Enrollment Date"
				membership_end_date as "Membership End Date"
				medical_certificate_url as "Medical Certificate URL"
				id_card_url as "ID Card URL"
				is_renewal_reminder_sent as "Is Renewal Reminder Sent"
			)
			options
			(
	 			display field = membership_status
	 		)
		}
		list enrollment_log_Report
		{
			displayName = "Enrollment Log Report"
			show all rows from enrollment_log    
			(
				member as "Member"
				previous_status as "Previous Status"
				new_status as "New Status"
				action_date as "Action Date"
				action_by as "Action By"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (previous_status == "Active")
				fields = [previous_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (previous_status == "Enrolled")
				fields = [previous_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (previous_status == "Expired")
				fields = [previous_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban enrollment_log_by_previous_status
		{
			displayName = "Previous Statuses"
			show all rows from enrollment_log    
			(
				member as "Member"
				previous_status as "Previous Status"
				new_status as "New Status"
				action_date as "Action Date"
				action_by as "Action By"
			)
			options
			(
	 			display field = previous_status
	 		)
		}
		list membership_plan_Report
		{
			displayName = "Membership Plan Report"
			show all rows from membership_plan    
			(
				plan_name as "Plan Name"
				plan_price as "Plan Price"
				(
					display = total,average,min,max	
				)
				plan_duration_days as "Plan Duration Days"
			)
		}
		list gym_rules_snippet_Report
		{
			displayName = "Gym Rules Snippet Report"
			show all rows from gym_rules_snippet    
			(
				snippet_content as "Snippet Content"
				last_updated as "Last Updated"
			)
		}
		list trainer_profile_Report
		{
			displayName = "All Trainer Profiles"
			show all rows from trainer_profile    
			(
				trainer_id as "Trainer Id"
				trainer_name  as "Trainer Name"
				specialization as "Specialization"
				is_available_today as "Is Available Today"
			)
		}
		list renewal_reminder_log_Report
		{
			displayName = "Renewal Reminder Log Report"
			show all rows from renewal_reminder_log    
			(
				member as "Member"
				reminder_sent_date as "Reminder Sent Date"
				email_status as "Email Status"
			)
		}
	}
	pages
	{
		page DashBoard
