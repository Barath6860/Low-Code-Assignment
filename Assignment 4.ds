		workflow
		{
		form
		{
			auto_set_membership_end_date as "Auto-set Membership End Date"
			{
				type =  form
				form = member_profile

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the plan details based on the selected plan type
										planRecords = membership_plan[plan_name == input.plan_type];
										// Check if plan record exists
										if(planRecords.count() > 0)
										{
											// Get the plan duration in days from the matched plan
											planDuration = planRecords.plan_duration_days;
											// Get the enrollment date from input
											enrollmentDate = input.enrollment_date;
											// Calculate the end date by adding plan duration days to enrollment date
											membershipEndDate = enrollmentDate.addDay(planDuration);
											// Set the membership_end_date field value
											input.membership_end_date = membershipEndDate;
										}
										else
										{
											// Handle case where plan is not found
											info "Plan not found for: " + input.plan_type;
										}
						)
					}
				}

			}
			prevent_duplicate_renewal_reminders as "Prevent Duplicate Renewal Reminders"
			{
				type =  form
				form = member_profile

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if the renewal reminder was already sent for this member
										if(input.is_renewal_reminder_sent == true)
										{
											alert "A renewal reminder has already been sent for this member. Please do not resubmit.";
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_expiring_membership_check as "Daily Expiring Membership Check"
			{
				type =  schedule
				form = member_profile
					status = inactive
				start = membership_end_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch member profiles with membership ending within 7 days
										expiringMembers = member_profile[membership_end_date in next 7 days];
										// Iterate through each expiring member
										for each  member in expiringMembers
										{
											// Check if email field is not null or empty
											if(member.email.isNull())
											{
												continue;
											}
											// Get membership end date
											endDate = member.membership_end_date;
											// Calculate days remaining
											daysRemaining = endDate.daysBetween(zoho.currentdate);
											// Prepare email subject
											subject = "Membership Expiry Reminder - " + daysRemaining.toString() + " Days Left";
											// Prepare email message
											message = "Dear " + member.member_name.first_name + ",\n\n";
											message = message + "This is a reminder that your membership is expiring in " + daysRemaining.toString() + " days.\n";
											message = message + "Your membership end date is: " + endDate.getDateTime() + "\n\n";
											message = message + "Please renew your membership to continue enjoying our services.\n\n";
											message = message + "Thank you for being a valued member!\n\n";
											message = message + "Best regards,\nGym Management Team";
											// Send email reminder
											sendmail
											[
												from :zoho.loginuserid
												to :member.email
												subject :subject
												message :message
												content type :Plain Text
											]
										}
					)
					}
				}
			}
		}




