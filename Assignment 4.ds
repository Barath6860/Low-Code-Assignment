 application "Gym Membership Enrollment Front Desk Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form class_schedule
		{
			displayname = "Class Schedule"
			success message = "Class Schedule Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			class_name
			(
    			type = text
				displayname = "Class Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			trainer
			(
				type = list	
				displayname = "Trainer"
				values  = trainer_profile.ID
    			displayformat = [trainer_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			class_date
			(
    			type = date
				displayname = "Class Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			class_time
			(
    			type = time
				displayname = "Class Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			max_capacity
			(
				type = number
				displayname = "Max Capacity"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_enrollment
			(
				type = number
				displayname = "Current Enrollment"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form enrollment_log
		{
			displayname = "Enrollment Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member
			(
				type = list	
				displayname = "Member"
				values  = member_profile.ID
    			displayformat = [member_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			previous_status
			(
				type = picklist
				displayname = "Previous Status"
				values = {"Enrolled","Enquiry","Active","Expired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			new_status
			(
				type = picklist
				displayname = "New Status"
				values = {"Enrolled","Enquiry","Active","Expired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_date
			(
    			type = datetime
				displayname = "Action Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_by
			(
    			type = text
				displayname = "Action By"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form gym_rules_snippet
		{
			displayname = "Gym Rules Snippet"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			snippet_content
			(
    			type = textarea
				displayname = "Snippet Content"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_updated
			(
    			type = datetime
				displayname = "Last Updated"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form member_profile
		{
			displayname = "Member Profile"
			success message = "Member Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member_id
			(
    			type = autonumber
				displayname = "Member Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_name
			(
    			type = name
				displayname = "Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_status
			(
				type = picklist
				displayname = "Membership Status"
				values = {"Enrolled","Enquiry","Active","Expired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			plan_type
			(
				type = picklist
				displayname = "Plan Type"
				values = {"Basic","Annual","Standard","Premium"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			enrollment_date
			(
    			type = date
				displayname = "Enrollment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_end_date
			(
    			type = date
				displayname = "Membership End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			medical_certificate_url
			(
    			type = url
				displayname = "Medical Certificate URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			id_card_url
			(
    			type = url
				displayname = "ID Card URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_renewal_reminder_sent
			(
    			type = checkbox
				displayname = "Is Renewal Reminder Sent"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enquiry Received","Initial Assessment","Enquiry Rejected","Eligibility Verification","Document Collection","Document Review","Plan Selection","Payment Processing","Payment Pending","Payment Completed","Final Approval","Active Enrollment","Membership Expiring","Renewal Process","Membership Expired"}
			}
		}
