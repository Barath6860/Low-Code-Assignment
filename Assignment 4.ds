		form trainer_profile
		{
			displayname = "Trainer Profile"
			success message = "Trainer Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			trainer_id
			(
    			type = autonumber
				displayname = "Trainer Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			trainer_name
			(
    			type = name
				displayname = "Trainer Name"
     			prefix
     			(
	     			 type = prefix
