		form renewal_reminder_log
		{
			displayname = "Renewal Reminder Log"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member
			(
				type = list	
				displayname = "Member"
				values  = member_profile.ID
    			displayformat = [member_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			reminder_sent_date
			(
    			type = datetime
				displayname = "Reminder Sent Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_status
			(
				type = radiobuttons
				displayname = "Email Status"
				values = {"Failed","Sent"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
