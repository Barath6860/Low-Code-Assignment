 application "Gym Membership Enrollment Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form member_profile
		{
			displayname = "Member Profile"
			success message = "Member Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member_name
			(
    			type = name
				displayname = "Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_plan
			(
				type = picklist
				displayname = "Membership Plan"
				values = {"Basic","Corporate","Standard","Premium"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_type
			(
				type = picklist
				displayname = "Membership Type"
				values = {"New","Corporate","Renewal"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Enrolled","Enquiry","Active","Expired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			fee_paid_status
			(
				type = picklist
				displayname = "Fee Paid Status"
				values = {"Partial","Paid","Unpaid"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			attendance_today
			(
    			type = checkbox
				displayname = "Attendance Today"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			renewal_due_date
			(
    			type = date
				displayname = "Renewal Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_start_date
			(
    			type = date
				displayname = "Preferred Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			enrollment_submitted_on
			(
    			type = datetime
				displayname = "Enrollment Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_trainer
			(
    			type = text
				displayname = "Assigned Trainer"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enquiry Received","Profile Created","Enquiry Archived","Pending Verification","Documents Under Review","Eligibility Approved","Eligibility Rejected","Plan Selection","Pending Payment","Payment Confirmed","Payment Failed","Active Enrollment","Membership Active","Renewal Pending","Membership Suspended","Membership Terminated"}
			}
		}
		form trainer_profile
		{
			displayname = "Trainer Profile"
			success message = "Trainer Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			trainer_name
			(
    			type = name
				displayname = "Trainer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			specialization
			(
				type = picklist
				displayname = "Specialization"
				values = {"Cardio","General","Yoga","HIIT","Strength"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list member_profile_Report
		{
			displayName = "All Member Profiles"
			show all rows from member_profile    
			(
				member_name  as "Member Name"
				contact_number as "Contact Number"
				email as "Email Address"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				membership_plan as "Membership Plan"
				membership_type as "Membership Type"
				status as "Status"
				fee_paid_status as "Fee Paid Status"
				attendance_today as "Attendance Today"
				renewal_due_date as "Renewal Due Date"
				preferred_start_date as "Preferred Start Date"
				enrollment_submitted_on as "Enrollment Submitted On"
				assigned_trainer as "Assigned Trainer"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (membership_plan == "Basic")
				fields = [membership_plan]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (membership_plan == "Corporate")
				fields = [membership_plan]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (membership_plan == "Premium")
				fields = [membership_plan]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban member_profile_by_membership_plan
		{
			displayName = "Member Profiles Board"
			show all rows from member_profile    
			(
				member_name  as "Member Name"
				contact_number as "Contact Number"
				email as "Email Address"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				membership_plan as "Membership Plan"
				membership_type as "Membership Type"
				status as "Status"
				fee_paid_status as "Fee Paid Status"
				attendance_today as "Attendance Today"
				renewal_due_date as "Renewal Due Date"
				preferred_start_date as "Preferred Start Date"
				enrollment_submitted_on as "Enrollment Submitted On"
				assigned_trainer as "Assigned Trainer"
			)
			options
			(
	 			display field = membership_plan
	 		)
		}
		list trainer_profile_Report
		{
			displayName = "All Trainer Profiles"
			show all rows from trainer_profile    
			(
				trainer_name  as "Trainer Name"
				specialization as "Specialization"
			)
		}
		kanban trainer_profile_by_specialization
		{
			displayName = "Specializations"
			show all rows from trainer_profile    
			(
				trainer_name  as "Trainer Name"
				specialization as "Specialization"
			)
			options
			(
	 			display field = specialization
	 		)
		}
	}
