		}
	}




		workflow
		{
		form
		{
			auto_assign_trainer as "Auto-assign Trainer on Enrollment"
			{
				type =  form
				form = member_profile

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the membership plan from input
										membershipPlan = input.membership_plan;
										// Initialize trainer variable
										trainerID = null;
										// Determine trainer based on membership plan
										if(membershipPlan == "Basic")
										{
											trainerID = 1001;
										}
										else if(membershipPlan == "Corporate")
										{
											trainerID = 1002;
										}
										else if(membershipPlan == "Standard")
										{
											trainerID = 1003;
										}
										else if(membershipPlan == "Premium")
										{
											trainerID = 1004;
										}
										// If trainer ID is set, assign it to the assigned_trainer field
										if(!trainerID.isNull())
										{
											input.assigned_trainer = trainerID;
										}
						)
					}
				}

			}
			block_unpaid_renewals as "Block Unpaid Renewals"
			{
				type =  form
				form = member_profile

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if membership type is Renewal and fee status is Unpaid
										if(input.membership_type == "Renewal" && input.fee_paid_status == "Unpaid")
										{
											alert "Cannot submit renewal: Fee status is Unpaid. Please update the fee status before submission.";
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			monthly_billing_report as "Monthly Billing Report"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all member profiles with unpaid fees
										unpaidMembers = member_profile[fee_paid_status == "Unpaid"];
										// Check if there are any unpaid members
										if(unpaidMembers.count() > 0)
										{
											// Build the summary message
											summaryMessage = "Monthly Unpaid Fees Summary\n\n";
											summaryMessage = summaryMessage.concat("Total Unpaid Members: ").concat(unpaidMembers.count().toString()).concat("\n\n");
											// Iterate through each unpaid member to add details
											for each  member in unpaidMembers
											{
												memberName = member.member_name.first_name;
												if(memberName == null || memberName.isEmpty())
												{
													memberName = member.member_name.last_name;
												}
												membershipType = member.membership_type;
												membershipPlan = member.membership_plan;
												email = member.email;
												summaryMessage = summaryMessage.concat("Member: ").concat(memberName).concat("\n");
												summaryMessage = summaryMessage.concat("Membership Type: ").concat(membershipType).concat("\n");
												summaryMessage = summaryMessage.concat("Membership Plan: ").concat(membershipPlan).concat("\n");
												if(!email.isEmpty())
												{
													summaryMessage = summaryMessage.concat("Email: ").concat(email).concat("\n");
												}
												summaryMessage = summaryMessage.concat("------------------------\n");
											}
											// Send email to finance team
											sendmail
											[
												from :zoho.adminuserid
												to :"finance@gym-membership.com"
												subject :"Monthly Unpaid Fees Summary"
												message :summaryMessage
												content type :Plain Text
											]
										}
					)
					}
				}
			}
		}




	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			"Member"
			{
				name = "Member"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Submit enrollment applications and select preferred membership plans \n"
				ModulePermissions
				{
					member_profile
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							member_profile_by_membership_plan={"View","Edit"}
							member_profile_Report={"View","Edit"}
						}
					}
				}
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


