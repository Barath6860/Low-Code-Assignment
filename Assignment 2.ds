 application "Gym Membership Enrollment Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form family_member
		{
			displayname = "Family Member"
			success message = "Family Member Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member
			(
				type = list	
				displayname = "Member Profile"
				values  = member_profile.ID
    			displayformat = [member_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			family_member_name
			(
    			type = name
				displayname = "Family Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			family_member_age
			(
				type = number
				displayname = "Family Member Age"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			relationship
			(
    			type = text
				displayname = "Relationship"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Family Member Registration Initiated","Pending Validation","Family Member Active","Pending Correction","Registration Cancelled","Pending Review","Pending Deactivation","Family Member Inactive"}
			}
		}
		form member_profile
		{
			displayname = "Member Profile"
			success message = "Member Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member_id
			(
    			type = autonumber
				displayname = "Member Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			first_name1
			(
    			type = name
				displayname = "First Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_name1
			(
    			type = name
				displayname = "Last Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_photo
			(
    			type = text
				displayname = "Member Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			social_profile_url
			(
    			type = url
				displayname = "Social Profile URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			requires_personal_trainer
			(
    			type = checkbox
				displayname = "Requires Personal Trainer"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_bmi
			(
				type = decimal
				displayname = "Current BMI"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			medical_certificate
			(
    			type = text
				displayname = "Medical Certificate"
	 			row = 1
	 			column = 1   
				width = medium
			)
			health_concern_voice
			(
    			type = text
				displayname = "Health Concern Voice Note"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fitness_goal_video
			(
    			type = text
				displayname = "Fitness Goal Video Intro"
	 			row = 1
	 			column = 1   
				width = medium
			)
			digital_signature
			(
    			type = text
				displayname = "Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			enrollment_submitted_on
			(
    			type = datetime
				displayname = "Enrollment Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_fee_paid
			(
				displayname = "Membership Fee Paid"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			referral_discount_percent
			(
    			type = percentage
				displayname = "Referral Discount Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount_payable
			(
				displayname = "Total Amount Payable"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_trainer
			(
				type = list	
				displayname = "Assigned Trainer"
				values  = trainers.ID
    			displayformat = [trainer_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_access_qr
			(
    			type = text
				displayname = "Member Access QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			gym_rules_display
			(
    			type = textarea
				displayname = "Gym Rules Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enrollment Initiated","Profile Data Collection","Enrollment Draft","Document Verification","Trainer Assignment","Financial Calculation","Payment Processing","Membership Active","Payment Pending","Enrollment Cancelled","Onboarding Complete"}
			}
		}
		form trainers
		{
			displayname = "Trainers"
			success message = "Trainers Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			trainer_id
			(
    			type = autonumber
				displayname = "Trainer Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			trainer_name
			(
    			type = name
				displayname = "Trainer Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
