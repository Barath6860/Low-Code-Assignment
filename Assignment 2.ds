		workflow
		{
		form
		{
			auto_calculate_membership_fee as "Auto-calculate Membership Fee"
			{
				type =  form
				form = member_profile

				record event = on add or edit

				on user input of referral_discount_percent
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the member profile record to access membership fee and discount
										memberProfile = member_profile[ID == input.ID];
										// Get the membership fee payable amount
										membershipFee = memberProfile.membership_fee_paid;
										// Get the referral discount percentage
										referralDiscountPercent = memberProfile.referral_discount_percent;
										// Validate that membership fee is not null
										if(membershipFee.isNull())
										{
											info "Membership fee is not set";
											return;
										}
										// Validate that discount percentage is not null
										if(referralDiscountPercent.isNull())
										{
											info "Referral discount percentage is not set";
											return;
										}
										// Convert discount percentage to decimal (divide by 100)
										discountDecimal = referralDiscountPercent.toDecimal() / 100;
										// Calculate the discount amount
										discountAmount = membershipFee * discountDecimal;
										// Calculate the total amount payable after discount
										totalAmountPayable = membershipFee - discountAmount;
										// Update the total_amount_payable field in the member profile record
										memberProfile.total_amount_payable=totalAmountPayable;
										// The update is applied automatically once the field is assigned
						)
					}
				}

			}
			validate_medical_certificate as "Validate Medical Certificate"
			{
				type =  form
				form = member_profile

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if medical_certificate field is empty
										if(input.medical_certificate.isEmpty())
										{
											// Display error message to user
											alert "Error: Medical certificate is required. Please upload a valid certificate before submitting.";
											// Cancel the form submission
											cancel submit;
										}
						)
					}
				}

			}
			send_welcome_email as "Send Welcome Email"
			{
				type =  form
				form = member_profile

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the new member record to get email and QR code
										memberRecord = member_profile[ID == input.ID];
										// Validate that email and QR code exist
										if(memberRecord.email.isNull() || memberRecord.member_access_qr.isNull())
										{
											info "Email or QR code is missing for member";
										}
										else
										{
											// Construct email message with QR code
											emailSubject = "Welcome to Our Gym!";
											emailMessage = "<p>Dear " + memberRecord.member_access_qr + ",</p>" + "<p>Welcome to our gym membership! Your QR code for access is attached.</p>" + "<p>Best regards,</p>" + "<p>Gym Management Team</p>";
											// Send welcome email with QR code
											sendmail
											[
												from :zoho.loginuserid
												to :memberRecord.email
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			monthly_fee_reminder as "Monthly Fee Reminder"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch members with unpaid fees (membership_fee_paid is 0 or null)
										membersWithUnpaidFees = member_profile[membership_fee_paid == 0 || membership_fee_paid.isNull()];
										// Check if there are any members with unpaid fees
										if(membersWithUnpaidFees.count() > 0)
										{
											// Iterate through each member with unpaid fees
											for each  member in membersWithUnpaidFees
											{
												// Validate email field
												if(member.email.isNull())
												{
													continue;
												}
												// Get member's first name from composite field first_name1
												memberFirstName = member.first_name1.first_name;
												// Get member's last name from composite field last_name1
												memberLastName = member.last_name1.last_name;
												// Get total amount payable
												totalAmount = member.total_amount_payable;
												// Get membership fee paid
												feePaid = member.membership_fee_paid;
												// Calculate remaining amount
												remainingAmount = totalAmount - feePaid;
												// Prepare email subject
												emailSubject = "Payment Reminder: Outstanding Membership Fees";
												// Prepare email message
												emailMessage = "Dear " + memberFirstName + " " + memberLastName + ",\n\n";
												emailMessage = emailMessage.concat("This is a reminder that your membership fees are still outstanding.\n");
												emailMessage = emailMessage.concat("Total Amount Payable: " + totalAmount.toString() + "\n");
												emailMessage = emailMessage.concat("Amount Paid: " + feePaid.toString() + "\n");
												emailMessage = emailMessage.concat("Remaining Amount Due: " + remainingAmount.toString() + "\n\n");
												emailMessage = emailMessage.concat("Please complete your payment at your earliest convenience.\n\n");
												emailMessage = emailMessage.concat("Thank you for your prompt attention to this matter.\n\n");
												emailMessage = emailMessage.concat("Best regards,\nGym Management Team");
												// Send email to the member
												sendmail
												[
													from :zoho.loginuserid
													to :member.email
													subject :emailSubject
													message :emailMessage
													content type :Plain Text
												]
											}
										}
					)
					}
				}
			}
		}


