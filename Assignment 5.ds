					)
				}
			}
		}
		form member_profile
		{
			displayname = "Member Profile"
			success message = "Member Profile Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member_id
			(
    			type = autonumber
				displayname = "Member Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			member_name
			(
    			type = name
				displayname = "Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			photo
			(
    			type = url
				displayname = "Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_trainer
			(
    			type = text
				displayname = "Assigned Trainer"
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_type
			(
				type = picklist
				displayname = "Membership Type"
				values = {"Individual","Corporate","Bulk"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Enquiry","Pending Approval","Payment","Active","Document Verification","Expired"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_start_date
			(
    			type = date
				displayname = "Membership Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			membership_end_date
			(
    			type = date
				displayname = "Membership End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			total_amount_payable
			(
				displayname = "Total Amount Payable"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			fee_paid_status
			(
				type = picklist
				displayname = "Fee Paid Status"
				values = {"Failed","Paid","Unpaid"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			transaction_reference
			(
    			type = text
				displayname = "Transaction Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			renewal_count
			(
				type = number
				displayname = "Renewal Count"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_comment
			(
    			type = textarea
				displayname = "Approval Comment"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			updated_date
			(
    			type = datetime
				displayname = "Updated Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enquiry Received","Member Profile Created","Enquiry Rejected","Verification Pending","Verification Approved","Verification Failed","Payment Pending","Payment Confirmed","Payment Failed","Approval Pending","Member Active","Membership Renewal","Membership Expired","Membership Suspended"}
			}
		}
