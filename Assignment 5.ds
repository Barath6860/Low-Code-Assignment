		workflow
		{
		form
		{
			auto_set_status_on_payment as "Auto-set Membership Status on Payment"
			{
				type =  form
				form = member_profile

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the member profile record using the input member_id
										memberRecord = member_profile[ID == input.member_id];
										// Check if the record exists and fee_paid_status is Paid
										if(memberRecord.fee_paid_status == "Paid")
										{
											// Update the status field to Active
											memberRecord.status="Active";
											// Update the updated_date to current time
											memberRecord.updated_date=zoho.currenttime;
											// Log the update action
											info "Member status updated to Active for member ID: " + memberRecord.ID;
										}
										else
										{
											// Log if payment is not successful
											info "Payment not successful for member ID: " + memberRecord.ID;
										}
						)
					}
				}

			}
			validate_payment_before_submit as "Validate Payment Before Submission"
			{
				type =  form
				form = member_profile

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if fee_paid_status field is Failed or Unpaid
										if(input.fee_paid_status.equals("Failed") || input.fee_paid_status.equals("Unpaid"))
										{
											alert "Payment status cannot be Failed or Unpaid. Please update the payment status before submission.";
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			send_expiry_reminder_email as "Send Expiry Reminder Email"
			{
				type =  schedule
				form = member_profile
					status = inactive
				start = membership_end_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch members whose membership ends in 30 days
										membershipEndDate = input.membership_end_date;
										currentDate = zoho.currentdate;
										// Calculate the date 30 days from now
										thirtyDaysFromNow = currentDate.addDay(30);
										// Check if membership ends exactly 30 days from now
										if(membershipEndDate == thirtyDaysFromNow)
										{
											// Prepare email details
											memberName = input.member_name.first_name;
											memberEmail = input.email;
											membershipEndDateStr = membershipEndDate.toString("dd MMM yyyy");
											// Send email notification
											sendmail
											[
												from :zoho.loginuserid
												to :memberEmail
												subject :"Membership Renewal Reminder - 30 Days Left"
												message :"Dear " + memberName + ",\n\nYour membership is set to expire on " + membershipEndDateStr + ".\n\nPlease renew your membership to continue enjoying our services.\n\nBest regards,\nGym Team"
											]
										}
					)
					}
				}
			}
		}


