	reports
	{
		list payment_gateway_log_Report
		{
			displayName = "Payment Gateway Log Report"
			show all rows from payment_gateway_log    
			(
				member as "Member"
				payment_link as "Payment Link"
				payment_status as "Payment Status"
				transaction_ref as "Transaction Ref"
				retry_count as "Retry Count"
				gateway_response as "Gateway Response"
				payment_date as "Payment Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (payment_status == "Failed")
				fields = [payment_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (payment_status == "Pending")
				fields = [payment_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (payment_status == "Success")
				fields = [payment_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban payment_gateway_log_by_payment_status
		{
			displayName = "Payment Statuses"
			show all rows from payment_gateway_log    
			(
				member as "Member"
				payment_link as "Payment Link"
				payment_status as "Payment Status"
				transaction_ref as "Transaction Ref"
				retry_count as "Retry Count"
				gateway_response as "Gateway Response"
				payment_date as "Payment Date"
			)
			options
			(
	 			display field = payment_status
	 		)
		}
		list membership_card_Report
		{
			displayName = "All Membership Cards"
			show all rows from membership_card    
			(
				member as "Member"
				card_generation_date as "Card Generation Date"
				card_url as "Card URL"
				qr_code_data as "QR Code Data"
				generated_by as "Generated By"
			)
		}
		list approval_request_Report
		{
			displayName = "All Approval Requests"
			show all rows from approval_request    
			(
				member as "Member"
				request_type as "Request Type"
				approver as "Approver"
				fallback_approver as "Fallback Approver"
				approval_status as "Approval Status"
				approval_date as "Approval Date"
				rejection_reason as "Rejection Reason"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (approval_status == "Approved")
				fields = [approval_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (approval_status == "Rejected")
				fields = [approval_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban approval_request_by_approval_status
		{
			displayName = "Approval Statuses"
			show all rows from approval_request    
			(
				member as "Member"
				request_type as "Request Type"
				approver as "Approver"
				fallback_approver as "Fallback Approver"
				approval_status as "Approval Status"
				approval_date as "Approval Date"
				rejection_reason as "Rejection Reason"
			)
			options
			(
	 			display field = approval_status
	 		)
		}
		list member_profile_Report
		{
			displayName = "All Member Profiles"
			show all rows from member_profile    
			(
				member_id as "Member Id"
				member_name  as "Member Name"
				email as "Email"
				phone_number as "Phone Number"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				photo as "Photo"
				assigned_trainer as "Assigned Trainer"
				membership_type as "Membership Type"
				status as "Status"
				membership_start_date as "Membership Start Date"
				membership_end_date as "Membership End Date"
				total_amount_payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				fee_paid_status as "Fee Paid Status"
				transaction_reference as "Transaction Reference"
				renewal_count as "Renewal Count"
				approval_comment as "Approval Comment"
				created_date as "Created Date"
				updated_date as "Updated Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (membership_type == "Bulk")
				fields = [membership_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (membership_type == "Corporate")
				fields = [membership_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (membership_type == "Individual")
				fields = [membership_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban member_profile_by_status
		{
			displayName = "Statuses"
			show all rows from member_profile    
			(
				member_id as "Member Id"
				member_name  as "Member Name"
				email as "Email"
				phone_number as "Phone Number"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				photo as "Photo"
				assigned_trainer as "Assigned Trainer"
				membership_type as "Membership Type"
				status as "Status"
				membership_start_date as "Membership Start Date"
				membership_end_date as "Membership End Date"
				total_amount_payable as "Total Amount Payable"
				(
					display = total,average,min,max	
				)
				fee_paid_status as "Fee Paid Status"
				transaction_reference as "Transaction Reference"
				renewal_count as "Renewal Count"
				approval_comment as "Approval Comment"
				created_date as "Created Date"
				updated_date as "Updated Date"
			)
			options
			(
	 			display field = status
	 		)
		}
		list expiry_notification_log_Report
		{
			displayName = "Expiry Notification Log Report"
			show all rows from expiry_notification_log    
			(
				member as "Member"
				notification_date as "Notification Date"
				notification_type as "Notification Type"
				email_sent as "Email Sent"
				discount_offer as "Discount Offer"
			)
		}
		list fee_adjustment_log_Report
		{
			displayName = "Fee Adjustment Log Report"
			show all rows from fee_adjustment_log    
			(
				member as "Member"
				original_fee as "Original Fee"
				(
					display = total,average,min,max	
				)
				new_fee as "New Fee"
				(
					display = total,average,min,max	
				)
				original_discount as "Original Discount"
				(
					display = total,average,min,max	
				)
				new_discount as "New Discount"
				(
					display = total,average,min,max	
				)
				adjusted_by as "Adjusted By"
				adjustment_date as "Adjustment Date"
				recalculation_result as "Recalculation Result"
				(
					display = total,average,min,max	
				)
			)
		}
	}
