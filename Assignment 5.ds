		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Section_1
				{
					displayname = "Dashboard"
					icon = "ui-1-dashboard-half"
					page DashBoard
					{
						icon = "ui-1-dashboard-half"
					}
				}
				section Section_2
				{
					displayname = "Payment Gateway Log"
					icon = "shopping-receipt"
					form  payment_gateway_log
					{
						icon = "ui-1-bold-add"
					}
					report payment_gateway_log_Report
					{
						icon = "shopping-cash-register"
					}
					report payment_gateway_log_by_payment_status
					{
						icon = "shopping-receipt"
					}
				}
				section Section_3
				{
					displayname = "Membership Cards"
					icon = "shopping-hand-card"
					form  membership_card
					{
						icon = "ui-1-bold-add"
					}
					report membership_card_Report
					{
						icon = "travel-world"
					}
				}
				section Section_4
				{
					displayname = "Approval Requests"
					icon = "design-todo"
					form  approval_request
					{
						icon = "ui-1-bold-add"
					}
					report approval_request_Report
					{
						icon = "travel-world"
					}
					report approval_request_by_approval_status
					{
						icon = "design-window-paragraph"
					}
				}
				section Section_5
				{
					displayname = "Member Profiles"
					icon = "shopping-receipt-list-43"
					form  member_profile
					{
						icon = "ui-1-bold-add"
					}
					report member_profile_Report
					{
						icon = "travel-world"
					}
					report member_profile_by_status
					{
						icon = "design-2-selection"
					}
				}
				section Section_6
				{
					displayname = "Expiry Notification Log"
					icon = "design-window-paragraph"
					form  expiry_notification_log
					{
						icon = "ui-1-bold-add"
					}
					report expiry_notification_log_Report
					{
						icon = "shopping-delivery-time"
					}
				}
				section Section_7
				{
					displayname = "Fee Adjustment Log"
					icon = "shopping-receipt"
					form  fee_adjustment_log
					{
						icon = "ui-1-bold-add"
					}
					report fee_adjustment_log_Report
					{
						icon = "shopping-cash-register"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
			}
			preference
			{
				icon
				{
					style = solid
					show = {space,section,component}
				}
			}
		}
		customize
		{
			new theme = 11
			font = "poppins"
			color options
			{
				color = "5"
			}
			logo
			{
				preference = "none"
				placement = "left"
			}
