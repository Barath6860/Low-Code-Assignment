 application "Gym Membership Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form approval_request
		{
			displayname = "Approval Request"
			success message = "Approval Request Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			member
			(
				type = list	
				displayname = "Member"
				values  = member_profile.ID
    			displayformat = [member_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_type
			(
				type = radiobuttons
				displayname = "Request Type"
				values = {"Corporate Tie-up","Bulk Discount"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			approver
			(
    			type = text
				displayname = "Approver"
	 			row = 1
	 			column = 1   
				width = medium
			)
			fallback_approver
			(
    			type = text
				displayname = "Fallback Approver"
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_status
			(
				type = picklist
				displayname = "Approval Status"
				values = {"Approved","Rejected","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_date
			(
    			type = datetime
				displayname = "Approval Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			rejection_reason
			(
    			type = textarea
				displayname = "Rejection Reason"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form expiry_notification_log
		{
			displayname = "Expiry Notification Log"
