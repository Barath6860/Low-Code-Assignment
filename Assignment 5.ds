				values  = member_profile.ID
    			displayformat = [member_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			notification_date
			(
    			type = date
				displayname = "Notification Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			notification_type
			(
				type = radiobuttons
